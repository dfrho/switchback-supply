{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npm run test:e2e)",
      "Bash(npm run build)",
      "Bash(npm run validate:catalog)",
      "Bash(npm run ld:setup -- --dry-run)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(cat .env)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
