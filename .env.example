# Copy this file to .env (same folder) and fill in your own values.
# .env is git-ignored. Never commit real keys or trigger URLs.

# Browser: LaunchDarkly client-side ID for your environment.
# LaunchDarkly > Settings > your project > your environment > SDK keys > Client-side IDs.
# Safe to expose: it is designed to ship in browser JavaScript.
VITE_LD_CLIENT_SIDE_ID=

# Remediation: the Generic flag trigger URL that turns release-new-checkout OFF.
# Shown only once when you create the trigger. Keep it secret.
# Deliberately NOT prefixed with VITE_, so it never reaches the browser bundle.
LD_TRIGGER_URL_CHECKOUT_OFF=

# Part 2 setup script (npm run ld:setup): a LaunchDarkly API access token.
# Gear icon (lower left) > Authorization (under Security, left navigation) > Tokens tab > Create token, role Writer. Shown only once.
# Keep it secret. Not prefixed with VITE_, so it never reaches the browser bundle.
LD_API_TOKEN=
# Optional: defaults are "default" and "production".
LD_PROJECT_KEY=
LD_ENVIRONMENT_KEY=

# AI shopping assistant (server-side only; never prefix these with VITE_).
# Server-side SDK key: LaunchDarkly > gear icon > Settings > All environments > the same
# environment as the client-side ID above > SDK keys tab > SDK key. Starts with "sdk-". Keep it secret.
LD_SDK_KEY=
# Optional: LD_LOG_LEVEL=debug shows the server SDK's connection and event delivery in the log.
LD_LOG_LEVEL=
# Anthropic API key: console.anthropic.com > API keys. Keep it secret, and set a spend limit.
ANTHROPIC_API_KEY=

# Optional: route the SDK through a LaunchDarkly Relay Proxy. Leave blank to connect directly.
# (The end-to-end tests set these to a local mock server automatically.)
VITE_LD_BASE_URI=
VITE_LD_STREAM_URI=
VITE_LD_EVENTS_URI=
