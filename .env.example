# Copy this file to .env (same folder) and fill in your own values.
# .env is git-ignored. Never commit real keys, tokens, or trigger URLs.

# VITE_LD_CLIENT_SIDE_ID
#   What:    LaunchDarkly client-side ID for your environment (Test in the README).
#   Where:   gear icon (lower left) > All environments > Test > SDK keys tab > Client-side IDs.
#   Secret:  No. It is designed to ship in browser JavaScript; the only VITE_ value here.
#   Used by: the storefront (npm run dev, and Vercel at build time).
VITE_LD_CLIENT_SIDE_ID=

# LD_TRIGGER_URL_CHECKOUT_OFF
#   What:    The Generic flag trigger URL that turns Release new checkout OFF.
#   Where:   created in README Step 4; shown only once (reset the trigger to get a new one).
#   Secret:  Yes. Anyone with the URL can turn the flag off. Never prefix with VITE_.
#   Used by: npm run remediate (scripts/remediate.sh), on your machine only.
LD_TRIGGER_URL_CHECKOUT_OFF=

# LD_API_TOKEN
#   What:    LaunchDarkly API access token, role Writer.
#   Where:   gear icon (lower left) > Authorization (under Security) > Tokens tab > Create token. Shown only once.
#   Secret:  Yes. Never prefix with VITE_.
#   Used by: npm run ld:setup (flags, segment, targeting, metrics, AgentControl config), on your machine only.
LD_API_TOKEN=

# LD_PROJECT_KEY
#   What:    The LaunchDarkly project ld:setup changes. Default: default.
#   Where:   gear icon (lower left) > All projects > the key chip under your project's name
#            (for example default).
#   Secret:  No.
#   Used by: npm run ld:setup. Change only if your project key is not "default".
LD_PROJECT_KEY=default

# LD_ENVIRONMENT_KEY
#   What:    The environment ld:setup changes. Default: test. It must be the environment
#            your VITE_LD_CLIENT_SIDE_ID belongs to (ld:setup checks, and stops if not).
#   Where:   gear icon (lower left) > All environments > click Test > the key chip beside
#            the name at the top of its page (for example test).
#   Secret:  No.
#   Used by: npm run ld:setup. Change only if you use an environment other than Test.
LD_ENVIRONMENT_KEY=test

# LD_SDK_KEY
#   What:    Server-side SDK key for the AI shopping assistant. Starts with "sdk-".
#   Where:   gear icon (lower left) > All environments > Test (the same environment as the
#            client-side ID) > SDK keys tab > SDK key.
#   Secret:  Yes. Server only; never prefix with VITE_.
#   Used by: the assistant API (npm run dev locally; Vercel, marked Sensitive).
LD_SDK_KEY=

# LD_LOG_LEVEL (optional)
#   What:    Set to debug to see the server SDK's connection and event delivery in the log.
#   Secret:  No. Leave blank normally.
LD_LOG_LEVEL=

# ANTHROPIC_API_KEY
#   What:    Anthropic API key for the AI shopping assistant (Claude).
#   Where:   console.anthropic.com > API keys. Set a monthly spend limit there too.
#   Secret:  Yes. Server only; never prefix with VITE_.
#   Used by: the assistant API (npm run dev locally; Vercel, marked Sensitive).
ANTHROPIC_API_KEY=

# VITE_LD_BASE_URI, VITE_LD_STREAM_URI, VITE_LD_EVENTS_URI (optional)
#   What:    Route the browser SDK through a LaunchDarkly Relay Proxy. Leave blank to
#            connect to LaunchDarkly directly. The end-to-end tests set these to a local
#            mock server automatically.
VITE_LD_BASE_URI=
VITE_LD_STREAM_URI=
VITE_LD_EVENTS_URI=
